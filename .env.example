# 로컬: npm run db:local 로 띄운 PGlite 서버
# 운영: Supabase → Project Settings → Database → Connection string (Transaction pooler, 6543)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# https://www.football-data.org/client/register 에서 무료 발급. 없으면 ESPN 대체 소스로 수집됨
FOOTBALL_DATA_API_KEY=

# /admin 관리자 페이지 비밀번호 (KBO·KBL 일정 입력). 비워 두면 관리자 기능이 꺼진다. 길고 무작위로.
ADMIN_PASSWORD=
