# 로컬: npm run db:local 로 띄운 PGlite 서버
# 운영: Supabase → Project Settings → Database → Connection string (Transaction pooler, 6543)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# https://www.football-data.org/client/register 에서 무료 발급. 없으면 ESPN 대체 소스로 수집됨
FOOTBALL_DATA_API_KEY=

# /admin 관리자 페이지 비밀번호 (KBO·KBL 일정 입력). 비워 두면 관리자 기능이 꺼진다. 길고 무작위로.
ADMIN_PASSWORD=

# 이메일 인증코드 로그인 (운영에서 셋 다 있어야 로그인 버튼이 보인다. 개발 중에는 코드가 콘솔에 찍힘)
# AUTH_SECRET: 코드·요청 제한 해시용 무작위 문자열 (32자 이상)
AUTH_SECRET=
# https://resend.com 에서 발급, 보내는 주소는 Resend 에 인증한 내 도메인이어야 함 (예: 마이팀 캘린더 <login@mail.example.com>)
RESEND_API_KEY=
MAIL_FROM=

# 하단 "문의·제안"에 보여줄 이메일 (비우면 표시하지 않음)
CONTACT_EMAIL=

# 경기 알림 메일: GitHub Actions 가 매시간 /api/cron/notify 를 부를 때 쓰는 비밀값 (Vercel 과 GitHub 저장소 비밀값에 같은 값)
CRON_SECRET=

# Cloudflare Turnstile (로그인 코드 요청 시 사람 확인). 둘 다 있을 때만 켜진다.
# https://dash.cloudflare.com → Turnstile → Add widget (도메인: my-team-calendar.com)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
